---
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    image?: string;
}

const {
    title,
    description = "Octlitch Linux is a Fedora-based KDE Plasma distribution focused on a fast, clean and polished desktop experience.",
    image = "/images/octlitch-logo.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
        name="description"
        content={description}
    />

    <meta
        name="robots"
        content="index, follow"
    />

    <meta
        name="theme-color"
        content="#07110f"
    />

    <link
        rel="canonical"
        href={canonicalURL}
    />

    <link
        rel="icon"
        type="image/png"

        href="/favicon.png"
    />
    <link 
	rel="icon"
	type="image/x-icon"
	href="/favicon.ico"
    />

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- Open Graph -->
    <meta
        property="og:type"
        content="website"
    />

    <meta
        property="og:site_name"
        content="Octlitch Linux"
    />

    <meta
        property="og:title"
        content={title}
    />

    <meta
        property="og:description"
        content={description}
    />

    <meta
        property="og:url"
        content={canonicalURL}
    />

    <meta
        property="og:image"
        content={imageURL}
    />

    <!-- Twitter / X -->
    <meta
        name="twitter:card"
        content="summary_large_image"
    />

    <meta
        name="twitter:title"
        content={title}
    />

    <meta
        name="twitter:description"
        content={description}
    />

    <meta
        name="twitter:image"
        content={imageURL}
    />
</head>    
<body>
        <header class="site-header">
            <div class="container nav">
                <a href="/" class="brand">
                    <img
                        src="/images/octlitch-logo.png"
                        alt="Octlitch logo"
                    />
                    <span>Octlitch</span>
                </a>

                <nav>
                    <a href="/">Home</a>
                    <a href="/news/">News</a>
                    <a href="/download/">Download</a>
                    <a href="/documentation/">Documentation</a>
                    <a
                        href="https://github.com/OctavianIlie/octlitch"
                        target="_blank"
                        rel="noreferrer"
                    >
                        GitHub
                    </a>
                </nav>
            </div>
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <div class="container footer-inner">
                <span>Octlitch Linux</span>
                <span>Built on Fedora with KDE Plasma.</span>
            </div>
        </footer>
    </body>
</html>
