---
import BaseLayout from "./BaseLayout.astro";
import { docsNavigation } from "../data/docs";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Octlitch Linux documentation"
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<BaseLayout
    title={`${title} — Octlitch Documentation`}
    description={description}
>
    <div class="docs">
        <aside class="docs-sidebar">
            <div class="docs-sidebar-inner">
                <div class="docs-sidebar-title">
                    Documentation
                </div>

                <nav class="docs-nav">
                    {
                        docsNavigation.map((section) => (
                            <section>
                                <h2>{section.title}</h2>

                                <ul>
                                    {
                                        section.items.map((item) => (
                                            <li>
                                                <a
                                                    href={item.href}
                                                    class:list={[
                                                        currentPath === item.href && "active"
                                                    ]}
                                                >
                                                    {item.title}
                                                </a>
                                            </li>
                                        ))
                                    }
                                </ul>
                            </section>
                        ))
                    }
                </nav>
            </div>
        </aside>

        <article class="docs-content">
            <div class="docs-article">
                <slot />
            </div>
        </article>
    </div>
</BaseLayout>
